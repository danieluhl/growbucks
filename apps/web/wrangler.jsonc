{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growbucks",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "growbucks",
      // Local dev works with this placeholder. Before deploying, run
      // `pnpm db:create` and paste the returned database_id here.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  // Throttles sign-in and device-linking attempts per email / IP.
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    // Where login-code emails come from. RESEND_API_KEY is a secret:
    // `wrangler secret put RESEND_API_KEY` (or .dev.vars locally). Without
    // it, codes are printed to the dev server console instead of emailed.
    "EMAIL_FROM": "GrowBucks <hello@growbucks.cash>"
  }
}
