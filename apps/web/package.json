{
  "name": "@growbucks/web",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "pnpm --silent db:migrate:local && vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "pnpm build && pnpm db:migrate:remote && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "postinstall": "WRANGLER_LOG=warn pnpm --silent cf-typegen",
    "db:create": "wrangler d1 create growbucks",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply growbucks --local",
    "db:migrate:remote": "wrangler d1 migrations apply growbucks --remote",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@growbucks/core": "workspace:*",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.168.59",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.49.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "wrangler": "4.143.1"
  }
}
